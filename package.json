{
  "name": "@eduardo191labs/opencode-free-pi",
  "version": "0.3.12",
  "description": "Ad-supported free-pi provider plugin for OpenCode on Windows, Linux, macOS and Termux",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/smoke.mjs && node test/registry.mjs && node test/models.mjs && node test/hooks.mjs && node test/title.mjs && node test/errors.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "free-pi",
    "free-pi-cli",
    "ai",
    "provider"
  ],
  "author": "eduardo191labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardo191-star/opencode-free-pi.git"
  },
  "bugs": {
    "url": "https://github.com/eduardo191-star/opencode-free-pi/issues"
  },
  "homepage": "https://github.com/eduardo191-star/opencode-free-pi#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2",
    "@opencode/schema": "^2.3.2"
  }
}
